{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mistake Trainer Next",
  "version": "0.1.1",
  "identifier": "com.mistaketrainer.next",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mistake Trainer Next",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../third-party-licenses/Apache-2.0.txt": "licenses/Apache-2.0.txt",
      "../third-party-licenses/heic2any-MIT.txt": "licenses/heic2any-MIT.txt",
      "../third-party-licenses/libheif-js-LGPL-3.0.txt": "licenses/libheif-js-LGPL-3.0.txt",
      "../third-party-licenses/libheif-LICENSE.txt": "licenses/libheif-LICENSE.txt",
      "resources/ocr-runtime/win-x64/onnxruntime.dll": "ocr-runtime/win-x64/onnxruntime.dll",
      "resources/ocr-runtime/win-x64/onnxruntime_providers_shared.dll": "ocr-runtime/win-x64/onnxruntime_providers_shared.dll",
      "resources/ocr-runtime/win-x64/Microsoft-ONNX-Runtime-LICENSE.txt": "licenses/Microsoft-ONNX-Runtime-LICENSE.txt",
      "resources/ocr-runtime/win-x64/Microsoft-ONNX-Runtime-ThirdPartyNotices.txt": "licenses/Microsoft-ONNX-Runtime-ThirdPartyNotices.txt"
    }
  }
}
