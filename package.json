{
  "name": "mistake-trainer-next",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "mobile:vendor": "node scripts/vendor-mobile-assets.js",
    "mobile:vendor:check": "node scripts/vendor-mobile-assets.js --check",
    "security:audit": "pnpm audit --prod",
    "build": "pnpm mobile:vendor:check && vue-tsc --noEmit && vite build",
    "bindings:generate": ".\\scripts\\cargo-msvc.cmd run --manifest-path src-tauri\\Cargo.toml --bin mistake-trainer-next -- --export-bindings",
    "bindings:check": "pnpm bindings:generate && git diff --exit-code -- src/shared/api/bindings.ts",
    "contract:architecture": "vitest run tests/architecture-dependency-direction.test.ts && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rust-boundary-contract.ps1",
    "contract:rust-boundaries": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rust-boundary-contract.ps1",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "supabase:test": "supabase test db",
    "tauri": ".\\scripts\\tauri-msvc.cmd"
  },
  "dependencies": {
    "@lucide/vue": "^1.24.0",
    "@tanstack/vue-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "motion-v": "^2.3.0",
    "pdfjs-dist": "5.4.624",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.1",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "^16.5.0",
    "heic2any": "0.0.4",
    "jsdom": "^29.1.1",
    "supabase": "2.109.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
